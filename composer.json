{
	"name": "pressgang-wp/phpstan",
	"description": "PHPStan extensions for PressGang controller manifests and dynamic model getters.",
	"type": "phpstan-extension",
	"license": "MIT",
	"homepage": "https://pressgang.dev",
	"keywords": [
		"phpstan",
		"phpstan-extension",
		"static-analysis",
		"wordpress",
		"timber",
		"twig",
		"pressgang",
		"acf"
	],
	"authors": [
		{
			"name": "Benedict Wallis",
			"email": "ben@benedict-wallis.com",
			"homepage": "https://benedict-wallis.com",
			"role": "Developer"
		}
	],
	"support": {
		"docs": "https://docs.pressgang.dev"
	},
	"require": {
		"php": "^8.2",
		"phpstan/phpstan": "^2.2.9"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.2",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"PressGang\\PHPStan\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PressGang\\PHPStan\\Tests\\": "tests/"
		},
		"classmap": [
			"tests/fixtures/"
		]
	},
	"extra": {
		"phpstan": {
			"includes": [
				"extension.neon"
			]
		}
	},
	"scripts": {
		"test": "phpunit",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"check": [
			"@test",
			"@phpstan",
			"@lint"
		],
		"lint": "phpcs"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
